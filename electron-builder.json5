{
  "appId": "com.bidderr.app",
  "productName": "Bidderr",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "shared/**/*",
    "branding/*.svg",
    "public/*.png",
    // koffi ships builds for every OS; the installer only needs 64-bit Windows.
    "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**",
    "!node_modules/koffi/{src,doc,vendor}/**"
  ],
  // Native Windows helper (koffi) must sit outside the app archive to load.
  "asarUnpack": ["node_modules/koffi/build/koffi/win32_x64/**"],
  // Where installed apps look for updates (electron-updater).
  "publish": [{ "provider": "github", "owner": "simplyzubair", "repo": "Bidderr" }],
  "win": {
    "icon": "public/icon.png",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true,
    "artifactName": "Bidderr-Setup.exe"
  }
}
