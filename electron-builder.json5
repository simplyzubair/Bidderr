{
  "appId": "com.bidderr.app",
  "productName": "Bidderr",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "shared/**/*",
    "branding/logo.svg",
    "public/*.png"
  ],
  // Where installed apps look for updates (electron-updater).
  "publish": [{ "provider": "github", "owner": "simplyzubair", "repo": "Bidderr" }],
  "win": {
    "icon": "public/icon.png",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true,
    "artifactName": "Bidderr-Setup.exe"
  }
}
