{
  "appId": "com.bidderr.app",
  "productName": "Bidderr",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "shared/**/*",
    "public/icon.png"
  ],
  "win": {
    "icon": "public/icon.png",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true,
    "artifactName": "Bidderr-Setup.exe"
  }
}
