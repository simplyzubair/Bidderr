{
  "name": "closer-ai",
  "version": "1.0.0",
  "description": "Custom AI Desktop Assistant for instant client messaging, proposal bidding, and smart clipboard automation.",
  "main": "electron/main.js",
  "author": "Closer AI Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
